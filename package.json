{
  "name": "rune-web",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node frontend/clean.mjs",
    "build": "yarn clean && tsc --project tsconfig.json",
    "build:test": "tsc --project tsconfig.test.json",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "yarn build && yarn build:test && node --test build/frontend-tests/tests/frontend/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.2"
  }
}
