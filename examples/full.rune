# Variables persist in the current session.
answer = 40
answer = answer + 2
answer

# Expressions and integer literal formats.
0b101010
(2 + 3) ** 2
-17 / 5
-17 % 5
(0b1010 << 2 | 0b0011) ^ 1

# Strings collapse to Unicode code-point sums.
"dog" + "cat"

# Logic and conditionals use the active chaos threshold.
@chaos 1
0 and missing
5 or missing
not 0
if ("dog" > "cat")
  1
else
  0
end if
if (0)
  0
elif (2)
  2
else
  0
end if

@chaos 10
5 or 20
if (5 or 20)
  99
else
  0
end if

# A scoped threshold is temporary and restores the surrounding value.
@chaos 1
chaos 500
  not 1
end chaos
not 1

# while and for loops remain bounded by the runtime limits.
@chaos 3
count = 5
while (count)
  count
  count = count - 1
end while
@chaos 1
for i from 1 to 5 step 2
  i
end for
for i from 1 to 5
  if (i == 2)
    continue
  end if
  if (i == 5)
    break
  end if
  i
end for

# Functions use local scope and may recurse.
function factorial(n)
  if (n <= 1)
    return 1
  end if
  return n * factorial(n - 1)
end function
factorial(5)
