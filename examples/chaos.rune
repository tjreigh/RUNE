# A called function observes the dynamically active chaos threshold.
function truth(value)
  if (value)
    return 1
  end if
  return 0
end function

@chaos 1
truth(1)

chaos 500
  truth(1)

  # Nested scopes restore the threshold active immediately outside them.
  chaos 1
    truth(1)
  end chaos

  truth(1)
end chaos

# Leaving the outer scope restores the persistent threshold.
truth(1)
